{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design", "label": "Settings Redesign + Integration Status Design (D1)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_integration_status_pill", "label": "Integration Status Pill (connected/failing)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display the last poller result rather than a live Test-connection button: integration config applies on restart, so the recorded status reflects the running config. Four states: connected (with last-worked relTime), failing, configured-not-run-yet, not configured."}, {"id": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_settings_tabs_cards", "label": "Settings Tab Templs + Setting Cards", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SettingsPage split into four focused tab templs dispatched by ActiveTab; presentation-only rework \u2014 every POST endpoint and field name unchanged, secrets still render blank."}, {"id": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_integration_fields_split", "label": "Per-Integration Field Templs (welcome-preserving)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "integrationsFields is shared with the onboarding welcome page, which must keep plain fieldsets; splitting into proxmoxFields/wireguardFields/piholeFields keeps the field names byte-identical for both pages and the save handler untouched, while settings wraps each in a status-carded header."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design", "target": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_integration_status_pill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design", "target": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_settings_tabs_cards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design", "target": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_integration_fields_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_integration_status_pill", "target": "docs_superpowers_specs_2026_07_11_netis_dashboard_design_integration_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-settings-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_settings_redesign_design_settings_tabs_cards", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_settings_tabs", "rel