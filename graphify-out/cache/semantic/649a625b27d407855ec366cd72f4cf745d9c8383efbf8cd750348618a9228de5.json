{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_device_model_fields_design", "label": "Richer Device Model Design (C1)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-model-fields-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_model_fields_design_model_function_fields", "label": "Model & Function Device Fields (migration 0005)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-model-fields-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model and function are first-class device columns (not custom fields) so they are sortable/filterable with dedicated inputs; function is one free-text field holding role + channel together. Vendor becomes user-editable: scan fills it only when it creates an unknown device and never updates existing rows, so a user edit is never clobbered. Explicit INSERT column list guards against silent column drift in the rebuild."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_model_fields_design_router_modem_kinds", "label": "Router & Modem Device Kinds", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-model-fields-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widening the kind CHECK requires the same table-rebuild idiom as migration 0002, so the two new columns ride the same rebuild."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_device_model_fields_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_model_fields_design_model_function_fields", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-model-fiel