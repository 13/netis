{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_device_list_design", "label": "Device List Overhaul Design (B)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_list_design_reviewed_flag", "label": "Device Reviewed Flag + Approve", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CreateDevice derives reviewed from source (reviewed = source != 'scan') so scan-created devices start as 'new' with no caller changes; UpdateDevice sets reviewed=1 because a human editing a device has reviewed it. Backfill marks existing non-scan devices reviewed."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_list_design_server_side_sorting", "label": "Server-side Device Sorting", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorting is server-side because numeric IP order requires Go (netip.ParseAddr + Addr.Compare) \u2014 a string sort would misorder .2/.10/.100. Unknown sort/dir values fall back to defaults, never a 500; devices with no IP sort last."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_list_design_list_grid_toggle", "label": "List/Grid View Toggle (localStorage)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side toggle persisted in localStorage; both views render the same sorted rows and the script restores the chosen view after each HTMX full re-render."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_device_list_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_list_design_reviewed_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_list_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_list_design_server_side_sorting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_list_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_list_design_list_grid_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_list_design", "target": "docs_superpowers_specs_2026_07_12_netis_design_system_design_component_set", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_list_design_reviewed_flag", "target": "docs_superpowers_specs_2026_07_11_netis_design_data_model", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-list-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_design_system_design_theme_toggle", "target": "docs_superpowers_specs_2026_07_12_ne