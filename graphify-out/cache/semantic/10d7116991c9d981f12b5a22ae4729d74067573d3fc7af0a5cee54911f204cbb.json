{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design", "label": "Subnet Occupancy Grid v2 Design (C3)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_full_range_grid", "label": "Full-Range Grid with Edge Squares (AllIPs)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render every address network..broadcast as a dense full-range map; network and broadcast are muted non-clickable edge squares. HostIPs is refactored to call AllIPs then trim edges, keeping its behavior and tests unchanged."}, {"id": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_lease_kind_toggle", "label": "Static/DHCP Lease Kind Toggle (SetIPKind)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two visual axes: fill color = occupancy/liveness (free/reserved/online/offline/conflict), border = lease kind (solid static, dashed dhcp). Toggle limited to static-vs-dhcp on already-assigned IPs; reserve/free needs placeholder device handling and is out of scope. No schema change \u2014 ip_assignment.kind already carries the CHECK."}, {"id": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_cell_detail_popup", "label": "CellDetail Popup", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clicking an assigned square opens a modal-shell popup (IP, device link, current lease, Set static / Set DHCP); the device-to-square navigation moves into the popup so nothing is lost by dropping the direct anchor. The toggle publishes grid:{id} over SSE so the open grid reloads with the flipped border."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design", "target": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_full_range_grid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design", "target": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_lease_kind_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design", "target": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_cell_detail_popup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_full_range_grid", "target": "docs_superpowers_specs_2026_07_11_netis_design_subnet_grid", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-07-12-netis-subnet-grid-v2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_subnet_grid_v2_design_cell_detail_popup", "target": "docs_superpowers_specs_2026_07_12_netis_scanning_ux_design_toast_system", "relation": "references", "confidence": 