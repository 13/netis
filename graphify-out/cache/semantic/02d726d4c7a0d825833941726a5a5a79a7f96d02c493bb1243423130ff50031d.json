design", "target": "docs_superpowers_specs_2026_07_11_netis_design_go_monolith_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_11_netis_design_scan_engine", "target": "internal_scan_oui_data_oui_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_11_netis_design_scan_engine", "target": "docs_superpowers_specs_2026_07_11_netis_design_data_model", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}