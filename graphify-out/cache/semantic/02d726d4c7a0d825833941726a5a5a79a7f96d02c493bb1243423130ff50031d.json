{"nodes": [{"id": "docs_superpowers_specs_2026_07_11_netis_design", "label": "Netis Core Design (Home Network Organizer)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_scan_engine", "label": "Scan Engine (ICMP/ARP sweep pipeline)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline only after N consecutive missed sweeps (default 3) to avoid flapping from sleeping phones; unprivileged UDP-ICMP fallback when CAP_NET_RAW is absent; ARP/MAC discovery limited to L2 segments the host sits on, remote subnets get ping-only."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_data_model", "label": "Netis SQLite Data Model", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subnet/device/interface/ip_assignment/status split so a device can have several NICs and one grid square per IP; device.source field keeps the model agent-ready even though agents were rejected."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_subnet_grid", "label": "Subnet Grid View", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The signature view: one square per IP with states used+online, used+offline, reserved, free, conflict derived from ip_assignment + status; squares flip live via SSE during scans."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_proxmox_integration", "label": "Proxmox Integration", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poller upserts VMs/LXCs as devices with parent_device_id pointing at the node's device; a stopped guest is shown as stopped, not spammed as offline events."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_wireguard_integration", "label": "WireGuard Integration (SSH wg show dump)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WireGuard runs on a remote host, so netis connects via SSH and parses wg show dump; peer online = handshake under 3 minutes; WireGuard subnets are never swept."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_sse_live_updates", "label": "SSE Live Updates (HTMX)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-rendered templ + HTMX with SSE fan-out for live refresh; clients reconnect automatically and the UI stays usable without live updates."}, {"id": "docs_superpowers_specs_2026_07_11_netis_design_go_monolith_architecture", "label": "Single Go Monolith Architecture", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-11-netis-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected server + per-segment scanner agents (full MAC coverage but two components and more ops; data model stays agent-ready via device.source) and shelling out to nmap (external dependency in a minimal image). SQLite via modernc.org/sqlite for pure Go, no CGO; assets embedded via go:embed; one static binary."}], "edg