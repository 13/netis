{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_onboarding_design", "label": "Onboarding & Settings Clarity Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_netdetect", "label": "netdetect Subnet Auto-Detection", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure package with an injectable interface-lister seam for tests (no real host networking). Filters down/loopback/link-local/host-route addresses and virtual interface prefixes (docker, veth, br-, tap, cni, virbr). Dedupe against already-configured subnets is the caller's job, keeping the package pure and independently testable."}, {"id": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_welcome_wizard", "label": "First-Run Welcome Wizard (onboarded gate)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gated by an 'onboarded' setting checked in requireAuth: the redirect survives a restart mid-wizard and prevents landing on an empty dashboard. A GetSetting error is treated as not-onboarded (fails safe). Invalid CIDRs are skipped so one typo doesn't block the batch."}, {"id": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_settings_tabs", "label": "Tabbed Settings Page", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-rendered tabs (subnets/integrations/users/general, unknown falls back to subnets) so the long stacked page shows one section at a time; each POST redirects back to its own tab."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_onboarding_design", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_netdetect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_onboarding_design", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_welcome_wizard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_onboarding_design", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_settings_tabs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_welcome_wizard", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_netdetect", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_settings_tabs", "target": "docs_superpowers_specs_2026_07_12_netis_onboarding_design_netdetect", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-onboarding-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}