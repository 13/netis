{"nodes": [{"id": "docs_superpowers_specs_2026_07_11_netis_pihole_design", "label": "Pi-hole Integration Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_11_netis_pihole_design_pihole_client", "label": "Pi-hole v6 API Client", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session auth: logs in on demand, caches the SID, sends X-FTL-SID; on 401 re-authenticates once and retries, a second 401 is an error. Malformed entries skipped, not fatal."}, {"id": "docs_superpowers_specs_2026_07_11_netis_pihole_design_pihole_sync", "label": "Pi-hole Reconciliation Sync", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never touches iface_status: a DHCP lease means 'has an address', not 'is online' \u2014 liveness stays the scanner's responsibility so the two never conflict. Reservations processed before leases so static wins over dhcp for the same MAC. DNS records never create MAC-less phantom devices. Idempotent; never deletes."}, {"id": "docs_superpowers_specs_2026_07_11_netis_pihole_design_upsert_ip_assignment", "label": "UpsertIPAssignment Store Method", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Select-then-update/insert provides both idempotency and the dhcp-to-static upgrade path; SetIfaceHostnameIfEmpty never overwrites an existing hostname."}, {"id": "docs_superpowers_specs_2026_07_11_netis_pihole_design_transactional_migrate_loop", "label": "Transactional Migrate Loop (FK-off rebuild)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite cannot ALTER a CHECK constraint, so widening device.source requires a table rebuild; DROP TABLE with foreign keys on would cascade-delete every child table's rows. PRAGMA foreign_keys cannot change inside a transaction, so FK toggling wraps the whole migration pass; per-migration foreign_key_check aborts on dangling references. Safe because migrations run once at startup on the single pooled connection."}], "edges": [{"source": "docs_superpowers_specs_2026_07_11_netis_pihole_design", "target": "docs_superpowers_specs_2026_07_11_netis_pihole_design_pihole_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_11_netis_pihole_design", "target": "docs_superpowers_specs_2026_07_11_netis_pihole_design_pihole_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_11_netis_pihole_design", "target": "docs_superpowers_specs_2026_07_11_netis_pihole_design_upsert_ip_assignment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-netis-pihole-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_11_netis_pihole_design", "target": "docs_superpowers_specs_2026_07_11_netis_pihole_design_transactional_migrate_loop", "relation": "references", "confidence": 