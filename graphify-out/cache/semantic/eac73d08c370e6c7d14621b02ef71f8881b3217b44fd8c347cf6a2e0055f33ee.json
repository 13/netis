{"nodes": [{"id": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design", "label": "Device Create/Edit Dialog Design (C)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_device_dialog", "label": "Device Create/Edit Dialog", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One HTMX fragment (dialog-scrim > dialog, no Layout) injected into a persistent #modal serves both create and edit, replacing the awkward full-page form and scattered per-field forms. Submits as a plain POST; the existing 303 redirect's full-page navigation is the modal-dismiss mechanism."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_set_device_tags", "label": "SetDeviceTags Tag Sync", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syncs a device's tags to exactly the given names (attach missing, detach removed, find-or-create); idempotent and order-independent. Lives in the store, not the web layer, because it is pure persistence logic. Empty input detaches all tags \u2014 the intended clear-tags behavior."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_icon_picker", "label": "Icon Picker (DeviceIcon + IconChoices)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DeviceIcon returns the chosen icon or the kind default; the kind-change handler replaces the icon only when the current value equals the previous kind's default (untouched), tracked via data-kind-default."}, {"id": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_dialog_js", "label": "dialog.js Modal Controller", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaded once by Layout; uses event delegation on document so it works for fragments injected after load. Handles scrim/Escape/data-close dismissal and the icon-picker interaction."}], "edges": [{"source": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_device_dialog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_set_device_tags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_icon_picker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-12-netis-device-dialog-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design", "target": "docs_superpowers_specs_2026_07_12_netis_device_dialog_design_dialog_js", "relation": "references", "confidence"