{"nodes": [{"id": "docs_superpowers_plans_2026_07_11_netis_pihole_implementation_plan", "label": "Pi-hole Integration Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-11-netis-pihole-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_11_netis_pihole_implementation_pihole_client", "label": "Pi-hole v6 API Client", "file_type": "concept", "rationale": "Auth is internal: POST /api/auth caches session.sid, sent as X-FTL-SID header, with a single re-auth retry on 401.", "source_file": "docs/superpowers/plans/2026-07-11-netis-pihole-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_11_netis_pihole_implementation_pihole_sync", "label": "Pi-hole Sync Reconciliation", "file_type": "concept", "rationale": "Read-only merge: match by MAC (create source=pihole devices for unknown MACs), never write iface_status, never delete, idempotent, never create devices from DNS records alone.", "source_file": "docs/superpowers/plans/2026-07-11-netis-pihole-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_11_netis_pihole_implementation_transactional_migrations", "label": "Transactional Migrations with FK Toggle", "file_type": "rationale", "rationale": "DROP TABLE during a rebuild with foreign keys ON cascade-deletes child rows; PRAGMA foreign_keys cannot change inside a transaction, so it is toggled OFF around the whole migration pass, each migration runs in a transaction with PRAGMA foreign_key_check, and Open() turns enforcement back on.", "source_file": "docs/superpowers/plans/2026-07-11-netis-pihole-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"i