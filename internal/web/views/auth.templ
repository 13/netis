package views

import "fmt"

templ onboardBrand() {
	<div class="onboard-brand">
		<span class="mark"><span class="dot"></span></span>
		<div class="wm">netis</div>
		<div class="tag">Your home network, organized.</div>
	</div>
}

templ onboardStep(n, cur int, label string) {
	if n < cur {
		<div class="step done">
			<span class="num">
				@Icon("check", "")
			</span>
			<span class="lbl">{ label }</span>
		</div>
	} else if n == cur {
		<div class="step active"><span class="num">{ fmt.Sprint(n) }</span><span class="lbl">{ label }</span></div>
	} else {
		<div class="step"><span class="num">{ fmt.Sprint(n) }</span><span class="lbl">{ label }</span></div>
	}
}

templ onboardStepper(step int) {
	<div class="stepper">
		@onboardStep(1, step, "Account")
		<i class="conn"></i>
		@onboardStep(2, step, "Subnets")
		<i class="conn"></i>
		@onboardStep(3, step, "Integrations")
	</div>
}

templ onboardShell(title string, step int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — netis</title>
			@themeBootstrap()
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="onboard">
			@onboardBrand()
			@onboardStepper(step)
			<div class="onboard-card">
				{ children... }
			</div>
			<script src="/static/theme.js"></script>
		</body>
	</html>
}

templ authShell(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — netis</title>
			@themeBootstrap()
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="onboard">
			{ children... }
			<script src="/static/theme.js"></script>
		</body>
	</html>
}

// LoginOptions says which ways in the login page offers.
type LoginOptions struct {
	// SSO shows the "Sign in with SSO" button.
	SSO bool
	// HidePassword leaves the password form off, behind a "local account"
	// link, when SSO is the primary way in.
	HidePassword bool
}

templ LoginPage(errMsg string, o LoginOptions) {
	@authShell("Login") {
		@onboardBrand()
		<div class="auth-card">
			if errMsg != "" {
				<p class="form-error" role="alert">{ errMsg }</p>
			}
			if o.SSO {
				<a href="/auth/oidc/login" class="btn btn-primary sso-button">Sign in with SSO</a>
			}
			if o.HidePassword {
				<a href="/login?local=1" class="muted">Sign in with a local account</a>
			} else {
				<form method="post" action="/login" class="auth-form">
					<input name="username" placeholder="username" autocomplete="username" autofocus?={ !o.SSO } required/>
					<input name="password" type="password" placeholder="password" autocomplete="current-password" required/>
					if o.SSO {
						<button type="submit" class="btn">Sign in with password</button>
					} else {
						<button type="submit" class="btn btn-primary">Sign in</button>
					}
				</form>
			}
		</div>
	}
}

templ SetupPage(errMsg string) {
	@onboardShell("Setup", 1) {
		<h1>Create your admin account</h1>
		<p class="muted">This is the login you'll use to manage netis.</p>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<form method="post" action="/setup">
			<input name="username" placeholder="username" autocomplete="username" autofocus required/>
			<input name="password" type="password" placeholder="password (min 8 chars)" autocomplete="new-password" required minlength="8"/>
			<button type="submit" class="btn btn-primary">Create account</button>
		</form>
	}
}
