package views

import "fmt"

// onboardBrand is the mark above the sign-in and first-run cards, in a
// header so that everything on those pages sits in a landmark.
templ onboardBrand() {
	<header class="onboard-brand">
		<img class="mark" src="/static/icon.svg" width="44" height="44" alt=""/>
		<div class="wm">netis</div>
		<div class="tag">Your home network, organized.</div>
	</header>
}

// onboardSteps are the first-run flow's steps, in order.
var onboardSteps = []string{"Account", "Network", "Services", "Done"}

// onboardStepper is the flow's step indicator: the steps done ticked, the
// current one marked for screen readers too.
templ onboardStepper(step int) {
	<ol class="stepper" aria-label="Setup steps">
		for i, label := range onboardSteps {
			if i+1 < step {
				<li class="step done">
					<span class="num">
						@Icon("check", "")
					</span>
					<span class="lbl">{ label }</span>
					<span class="sr-only">(done)</span>
				</li>
			} else if i+1 == step {
				<li class="step active" aria-current="step"><span class="num">{ fmt.Sprint(i + 1) }</span><span class="lbl">{ label }</span></li>
			} else {
				<li class="step"><span class="num">{ fmt.Sprint(i + 1) }</span><span class="lbl">{ label }</span></li>
			}
		}
	</ol>
}

// onboardShell is the minimal frame of the first-run flow: the mark, the
// step indicator and one card. htmx and the toasts are there for the last
// step's live scan count and Run now.
templ onboardShell(title string, step int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — netis</title>
			@themeBootstrap()
			@appIcons()
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/pages/setup.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/sse.js"></script>
		</head>
		<body class="onboard">
			@onboardBrand()
			@onboardStepper(step)
			<main class="onboard-card">
				{ children... }
			</main>
			<div id="toasts" class="toasts" role="status" aria-live="polite"></div>
			<script src="/static/theme.js"></script>
			<script src="/static/toasts.js"></script>
		</body>
	</html>
}

templ authShell(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — netis</title>
			@themeBootstrap()
			@appIcons()
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/pages/setup.css"/>
		</head>
		<body class="onboard">
			{ children... }
			<script src="/static/theme.js"></script>
		</body>
	</html>
}

// LoginOptions says which ways in the login page offers.
type LoginOptions struct {
	// SSO shows the "Sign in with SSO" button.
	SSO bool
	// HidePassword leaves the password form off, behind a "local account"
	// link, when SSO is the primary way in.
	HidePassword bool
}

templ LoginPage(errMsg string, o LoginOptions) {
	@authShell("Sign in") {
		@onboardBrand()
		<main class="auth-card">
			<h1 class="sr-only">Sign in to netis</h1>
			if errMsg != "" {
				<p class="form-error" role="alert">{ Sentence(errMsg) }</p>
			}
			if o.SSO {
				<a href="/auth/oidc/login" class="btn btn-primary sso-button">Sign in with SSO</a>
			}
			if o.HidePassword {
				<a href="/login?local=1" class="muted">Sign in with a local account</a>
			} else {
				<form method="post" action="/login" class="auth-form">
					<label>
						Username
						<input name="username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus?={ !o.SSO } required/>
					</label>
					<label>
						Password
						<input name="password" type="password" autocomplete="current-password" required/>
					</label>
					if o.SSO {
						<button type="submit" class="btn">Sign in with password</button>
					} else {
						<button type="submit" class="btn btn-primary">Sign in</button>
					}
				</form>
			}
		</main>
	}
}

templ SetupPage(errMsg string) {
	@onboardShell("Create your account", 1) {
		<h1>Create your admin account</h1>
		<p class="muted">The login you manage netis with. You stay signed in and carry on setting up.</p>
		if errMsg != "" {
			<p class="form-error" role="alert">{ Sentence(errMsg) }</p>
		}
		<form method="post" action="/setup">
			<label>
				Username
				<input name="username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required/>
			</label>
			<label>
				Password
				<input name="password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="pw-help"/>
			</label>
			<p class="hint" id="pw-help">At least 8 characters.</p>
			<div class="ob-actions">
				<button type="submit" class="btn btn-primary">Create account</button>
			</div>
		</form>
	}
}
