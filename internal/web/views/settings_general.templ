package views

templ generalTab(d SettingsData) {
	<h2>General</h2>
	<form method="post" action="/settings/general">
		<div class="panel">
			<div class="panel-head"><h3>Availability</h3></div>
			<label>Offline after (missed scans) <input type="number" name="offline_after" min="1" max="10" value={ generalOfflineAfter(d.Values) }/></label>
			<p class="hint">A device is marked offline after this many consecutive missed scans.</p>
			<label>Presence without ping
				<select name="presence_fallback">
					if d.Values["presence_fallback"] != "off" {
						<option value="on" selected>Enabled</option>
						<option value="off">Disabled</option>
					} else {
						<option value="on">Enabled</option>
						<option value="off" selected>Disabled</option>
					}
				</select>
			</label>
			<p class="hint">On directly attached subnets, a host that ignores ping but answers ARP (confirmed by a TCP connect or a second ARP check) counts as seen.</p>
		</div>
		<div class="panel">
			<div class="panel-head"><h3>Defaults for new subnets</h3></div>
			<div class="field-grid">
				<label>Default scan interval (s) <input type="number" name="default_scan_interval_sec" min="30" value={ settingOr(d.Values, "default_scan_interval_sec", "120") }/></label>
				<label>
					Default kind
					<select name="default_subnet_kind">
						for _, k := range subnetKinds {
							if k == settingOr(d.Values, "default_subnet_kind", "lan") {
								<option value={ k } selected>{ k }</option>
							} else {
								<option value={ k }>{ k }</option>
							}
						}
					</select>
				</label>
				<label>
					Default auto-scan
					<select name="default_scan_enabled">
						if defaultScanEnabled(d.Values) {
							<option value="on" selected>Enabled</option>
							<option value="off">Disabled</option>
						} else {
							<option value="on">Enabled</option>
							<option value="off" selected>Disabled</option>
						}
					</select>
				</label>
			</div>
			<p class="hint">Prefilled into the Add-subnet form.</p>
		</div>
		<div class="panel">
			<div class="panel-head"><h3>Retention</h3></div>
			<div class="field-grid">
				<label>Keep events (days) <input type="number" name="event_retention_days" min="0" value={ settingOr(d.Values, "event_retention_days", "30") }/></label>
				<label>Keep availability history (days) <input type="number" name="availability_retention_days" min="0" value={ settingOr(d.Values, "availability_retention_days", "365") }/></label>
				<label>Keep audit log (days) <input type="number" name="audit_retention_days" min="0" value={ settingOr(d.Values, "audit_retention_days", "180") }/></label>
			</div>
			<p class="hint">
				Older rows are deleted every six hours. Availability history is one row
				per interface per hour, so it is the fastest-growing table. Set a value
				to 0 to keep everything.
			</p>
		</div>
		<button type="submit" class="btn btn-primary">Save</button>
	</form>
}
