package views

// appIcons links the favicons, the home-screen icon and the web app manifest,
// and colours the browser chrome with the page background of each scheme.
// Every page shell puts it in its <head>. The assets are generated by
// gen_favicons.go from one drawing.
templ appIcons() {
	<link rel="icon" href="/favicon.ico" sizes="32x32"/>
	<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
	<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
	<link rel="manifest" href="/static/manifest.webmanifest"/>
	<meta name="theme-color" content="#ECEEEC" media="(prefers-color-scheme: light)"/>
	<meta name="theme-color" content="#161A18" media="(prefers-color-scheme: dark)"/>
}
