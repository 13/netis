package views

import (
	"fmt"
	"net/url"

	"netis/internal/store"
)

// AuditData is the Audit tab: one page of entries, newest first, under the
// user and action filters, plus the values those filters can take.
type AuditData struct {
	Entries []store.AuditEntry
	// More says there are older entries past this page.
	More bool
	// Paged says this is not the first page, so "Newest" is worth offering.
	Paged   bool
	User    string
	Action  string
	Users   []string
	Actions []string
	// Targets holds, by entry id, the targets resolved to a current name
	// and page. An entry absent here shows its target as recorded.
	Targets map[int64]AuditTarget
}

// AuditTarget is a resolved audit target. An empty Href means the thing has
// been deleted since.
type AuditTarget struct {
	Text, Href string
}

templ filterSelect(name, label, all, current string, options []string, text func(string) string) {
	<label>
		{ label }
		<select name={ name } onchange="this.form.submit()">
			<option value="">{ all }</option>
			for _, o := range options {
				if o == current {
					<option value={ o } selected>{ text(o) }</option>
				} else {
					<option value={ o }>{ text(o) }</option>
				}
			}
		</select>
	</label>
}

templ auditTab(a AuditData) {
	<p class="muted">Every change made through netis, and every refused attempt, newest first.</p>
	<form method="get" action="/settings/audit" class="toolbar">
		@filterSelect("user", "User", "All users", a.User, a.Users, func(s string) string { return s })
		@filterSelect("action", "Action", "All actions", a.Action, a.Actions, AuditActionLabel)
		<noscript><button type="submit" class="btn">Filter</button></noscript>
	</form>
	if len(a.Entries) == 0 && (a.User != "" || a.Action != "") {
		<div class="panel empty empty-compact">
			@Icon("filter", "")
			<h3>No entries match these filters</h3>
			<a class="btn btn-sm" href="/settings/audit">Clear filters</a>
		</div>
	} else if len(a.Entries) == 0 {
		<div class="panel empty empty-compact">
			@Icon("list", "")
			<h3>Nothing recorded yet</h3>
			<p>Changes made through netis, like adding a device or a user, are listed here with who made them and when.</p>
		</div>
	} else {
		<div class="table-wrap">
			<table class="table-stack">
				<tr><th>Time</th><th>User</th><th>Action</th><th>Target</th><th>Detail</th><th>Result</th><th>IP</th></tr>
				for _, e := range a.Entries {
					<tr>
						<td data-label="Time">
							@TimeAt(e.At)
						</td>
						<td data-label="User">
							if e.Username == "" {
								<span class="muted">—</span>
							} else {
								{ e.Username }
							}
						</td>
						<td data-label="Action" class="nowrap" title={ e.Action }>{ AuditActionLabel(e.Action) }</td>
						<td data-label="Target">
							if t, ok := a.Targets[e.ID]; !ok {
								{ e.Target }
							} else if t.Href != "" {
								<a href={ templ.URL(t.Href) }>{ t.Text }</a>
							} else {
								<span class="muted">{ t.Text }</span>
							}
						</td>
						<td data-label="Detail">{ Sentence(e.Detail) }</td>
						<td data-label="Result">
							if word, tone := auditOutcome(e.Status); tone != "" {
								<span class={ "status", tone } title={ statusTitle(e.Status) }>{ word }</span>
							} else {
								<span class="muted" title={ statusTitle(e.Status) }>{ word }</span>
							}
						</td>
						<td class="mono" data-label="IP">{ e.IP }</td>
					</tr>
				}
			</table>
		</div>
	}
	<p>
		if a.Paged {
			<a href={ templ.URL(auditPageURL(a, 0)) }>Newest entries</a>
		}
		if a.More && len(a.Entries) > 0 {
			<a href={ templ.URL(auditPageURL(a, a.Entries[len(a.Entries)-1].ID)) }>Older entries</a>
		}
	</p>
}

// auditPageURL links to the Audit tab under the current filters, starting
// below the entry with id before (0 for the newest page).
func auditPageURL(a AuditData, before int64) string {
	q := url.Values{}
	if a.User != "" {
		q.Set("user", a.User)
	}
	if a.Action != "" {
		q.Set("action", a.Action)
	}
	if before > 0 {
		q.Set("before", fmt.Sprint(before))
	}
	if len(q) == 0 {
		return "/settings/audit"
	}
	return "/settings/audit?" + q.Encode()
}
