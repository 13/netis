package views

import (
	"fmt"

	"netis/internal/store"
)

// deviceEventTypes are the event types that always name a device when
// recorded. One of these without a device lost it to a deletion.
var deviceEventTypes = map[string]bool{"device_new": true, "online": true, "offline": true, "ip_changed": true, "device_missing": true, "device_returned": true}

// EventStatus is an event's kind in words with its status dot ("Went
// offline"), the one way every page labels an event.
templ EventStatus(e store.Event) {
	<span class={ "status", EventInfo(e).Tone }>{ EventInfo(e).Label }</span>
}

// eventDevice names an event's device, linked to its page; an event whose
// device was deleted says so, and one that never had a device renders nothing.
templ eventDevice(e store.Event) {
	if e.DeviceID != nil && e.DeviceName != nil {
		<a href={ templ.URL(fmt.Sprintf("/devices/%d", *e.DeviceID)) }>{ *e.DeviceName }</a>
	} else if e.DeviceID != nil || deviceEventTypes[e.Type] {
		<span class="muted">Deleted device</span>
	}
}

// eventDays is a list of events under sticky day headings, shared by the
// events page and the dashboard's recent activity. level is the heading
// element's level so each page keeps its outline.
templ eventDays(days []EventDay, level int) {
	for _, day := range days {
		<section class="ev-day">
			if level == 2 {
				<h2 class="ev-day-h">@dayHeading(day)</h2>
			} else {
				<h3 class="ev-day-h">@dayHeading(day)</h3>
			}
			<ol class="ev-list">
				for _, e := range day.Events {
					@eventItem(e)
				}
			</ol>
		</section>
	}
}

// dayHeading is the day's name. It is not a <time datetime>: time.js would
// turn it into a relative time.
templ dayHeading(day EventDay) {
	{ day.Label }
}

// eventItem is one event: what happened, to which device, the details and
// when. On a phone it stacks with the kind and time on the first line.
templ eventItem(e store.Event) {
	<li class="ev">
		<span class="ev-kind">
			@EventStatus(e)
		</span>
		<span class="ev-dev">
			@eventDevice(e)
		</span>
		<span class="ev-detail">{ EventDetail(e) }</span>
		<span class="ev-time">
			@Time(e.TS)
		</span>
	</li>
}
