package views

import (
	"fmt"

	"netis/internal/store"
)

// DashRow is one subnet's occupancy. Online, Unseen and Offline split the
// used addresses by state; Reserved counts the static assignments (DHCP
// reservations and fixed IPs) among them whatever their state.
type DashRow struct {
	Subnet   store.Subnet
	Online   int
	Unseen   int
	Offline  int
	Reserved int
	Used     int
	Free     int
	Hosts    int
}

type DashStats struct {
	Total   int
	Online  int
	Offline int
	Unknown int
	Subnets int
}

type AttentionUnknown struct {
	ID   int64
	Name string
}

type AttentionConflict struct {
	IP         string
	SubnetID   int64
	SubnetName string
}

type DashboardData struct {
	Username     string
	Stats        DashStats
	Integrations []store.IntegrationStatus
	Unknowns     []AttentionUnknown
	Conflicts    []AttentionConflict
	Rows         []DashRow
	Events       []store.Event
}

templ Dashboard(d DashboardData) {
	@Layout("Dashboard", d.Username) {
		<h1>Dashboard</h1>
		<div id="dash" hx-get="/dashboard/widgets" hx-trigger="sse:dashboard, sse:events">
			@DashboardBody(d)
		</div>
	}
}

templ DashboardBody(d DashboardData) {
	<div class="stats">
		<div class="panel stat"><span class="num">{ fmt.Sprint(d.Stats.Total) }</span> <span class="lbl">devices</span></div>
		<div class="panel stat"><span class="num">{ fmt.Sprint(d.Stats.Online) }</span> <span class="lbl"><span class="dot is-online"></span>online</span></div>
		<div class="panel stat"><span class="num">{ fmt.Sprint(d.Stats.Offline) }</span> <span class="lbl"><span class="dot"></span>offline</span></div>
		<div class="panel stat"><span class="num">{ fmt.Sprint(d.Stats.Unknown) }</span> <span class="lbl"><span class="dot is-new"></span>unknown</span></div>
		<div class="panel stat"><span class="num">{ fmt.Sprint(d.Stats.Subnets) }</span> <span class="lbl">subnets</span></div>
	</div>
	<div class="band">
		<section class="panel">
			<h2>Integrations</h2>
			if len(d.Integrations) == 0 {
				<p class="muted">no integrations have run yet</p>
			} else {
				<table>
					for _, it := range d.Integrations {
						<tr>
							<td>{ it.Name }</td>
							<td>
								if it.OK {
									<span class="status is-online">ok</span>
								} else {
									<span class="status is-error">failing</span>
								}
							</td>
							<td class="muted">@Time(it.LastRun)</td>
							<td>{ it.Detail }</td>
						</tr>
					}
				</table>
			}
		</section>
		<section class="panel">
			<h2>Needs attention</h2>
			if len(d.Unknowns) == 0 && len(d.Conflicts) == 0 {
				<p class="muted">nothing needs attention</p>
			} else {
				<ul>
					for _, u := range d.Unknowns {
						<li>
							<a href={ templ.URL(fmt.Sprintf("/devices/%d", u.ID)) }>
								unknown device { u.Name }
							</a>
						</li>
					}
					for _, c := range d.Conflicts {
						<li>
							<a href={ templ.URL(fmt.Sprintf("/subnets/%d", c.SubnetID)) }>
								IP conflict { c.IP } in { c.SubnetName }
							</a>
						</li>
					}
				</ul>
			}
		</section>
	</div>
	<h2>
		Subnets
		if IsAdmin(ctx) {
			<button hx-post="/scan" hx-target="#toasts" hx-swap="beforeend" class="btn btn-sm">
				@Icon("radar", "")
				Scan all
			</button>
		}
	</h2>
	<div class="cards">
		for _, r := range d.Rows {
			@subnetCard(r)
		}
	</div>
	<h2>Recent events</h2>
	<div class="table-wrap">
	<table>
		for _, e := range d.Events {
			<tr>
				<td class="muted">@Time(e.TS)</td>
				<td><span class={ eventClass(e.Type) }>{ e.Type }</span></td>
				<td>
					@eventDevice(e)
				</td>
				<td>{ e.Details }</td>
			</tr>
		}
	</table>
	</div>
}

templ subnetCard(r DashRow) {
	<div class="panel">
		<div class="panel-head">
			<h3><a href={ templ.URL(fmt.Sprintf("/subnets/%d", r.Subnet.ID)) }>{ r.Subnet.Name }</a></h3>
			<span class="mono muted">{ r.Subnet.CIDR }</span>
			if r.Subnet.Kind != "wireguard" && IsAdmin(ctx) {
				<span class="spacer"></span>
				<button hx-post={ fmt.Sprintf("/subnets/%d/scan", r.Subnet.ID) } hx-target="#toasts" hx-swap="beforeend" class="btn btn-sm">
					@Icon("radar", "")
					Scan
				</button>
			}
		</div>
		<svg class="occ" aria-hidden="true">
			for _, seg := range occSegments(r) {
				<rect class={ seg.Class } x={ pct(seg.X) } width={ pct(seg.W) } height="100%"></rect>
			}
		</svg>
		<div class="legend">
			<span><span class="sw on"></span><b>{ fmt.Sprint(r.Online) }</b> online</span>
			<span><span class="sw off"></span><b>{ fmt.Sprint(r.Offline) }</b> offline</span>
			if r.Unseen > 0 {
				<span><span class="sw res"></span><b>{ fmt.Sprint(r.Unseen) }</b> not seen yet</span>
			}
			<span><span class="sw free"></span><b>{ fmt.Sprint(r.Free) }</b> free</span>
			<span><b>{ fmt.Sprint(r.Reserved) }</b> reserved</span>
		</div>
	</div>
}

templ SubnetsPage(username string, rows []DashRow) {
	@Layout("Subnets", username) {
		<div class="page-head">
			<h1>Subnets</h1>
			if IsAdmin(ctx) {
				<a class="btn" href="/settings/network">
					@Icon("settings", "")
					Manage subnets
				</a>
			}
		</div>
		<p class="muted">Open a subnet to see its occupancy grid — online, offline, not seen yet or free, and static (reserved) or DHCP.</p>
		if len(rows) == 0 {
			<div class="panel empty">
				@Icon("network", "")
				<h3>No subnets yet</h3>
				if IsAdmin(ctx) {
					<p>Add the networks netis should scan, and their devices show up here.</p>
					<a class="btn btn-primary" href="/settings/network">Add a subnet</a>
				} else {
					<p>An admin adds the networks netis scans.</p>
				}
			</div>
		} else {
			<div class="cards">
				for _, r := range rows {
					@subnetCard(r)
				}
			</div>
		}
	}
}
