package views

import (
	"netis/internal/buildinfo"
	"netis/internal/netdetect"
	"netis/internal/store"
)

var subnetKinds = []string{"lan", "wireguard", "proxmox-bridge"}

// SettingsData is the view-model for a settings page. Values never contains
// an integration secret (proxmox_secret, pihole_password, adguard_password,
// opnsense_secret) — those fields always render blank so the stored secrets
// are never echoed back.
type SettingsData struct {
	// CurrentUserID is the signed-in user, whose own row on the users tab
	// offers no delete.
	CurrentUserID int64
	Subnets       []store.Subnet
	Users   []store.User
	// Sessions are the signed-in user's own sessions, newest first, and
	// CurrentSessionID names the one that asked for this page.
	Sessions         []store.Session
	CurrentSessionID string
	Values           map[string]string
	// Configured says which integrations have settings, by name. Viewers get
	// this and not Values, which is left empty for them.
	Configured map[string]bool
	// ActiveTab is the settings page shown: one of the settingsSections
	// keys ("account", "network", ...).
	ActiveTab string
	Detected   []netdetect.Detected
	Statuses   map[string]store.IntegrationStatus
	About      AboutData
	// Notify is the Notifications tab, filled for admins on that tab only.
	Notify NotifyData
	// Audit is the Audit tab, loaded only when an admin opens it.
	Audit AuditData
	// Error is why the form just submitted on ActiveTab was refused, shown
	// above the tab.
	Error string
	// Tokens are the API tokens on the tokens tab: the user's own, or every
	// user's for an admin. NewToken is the plaintext of one just created,
	// shown this once.
	Tokens   []store.APIToken
	NewToken string
	// SSO is the signed-in user's single sign-on state, on the users tab.
	SSO SSOAccount
	// Tags are every tag with its device count, on the tags tab.
	Tags []store.TagCount
}

// SSOAccount says whether SSO is configured and whether the signed-in user's
// account is linked to an identity at the provider.
type SSOAccount struct {
	Enabled bool
	Linked  bool
}

// AboutData is what the About tab reports: the build the binary came from plus
// the facts about the process serving this request.
type AboutData struct {
	Info    buildinfo.Info
	Uptime  string
	Backend string // "sqlite" or "postgres"
	Now     string
	Backup  BackupView
}

// BackupView is the scheduled-backup line on the About tab. Note, when set,
// is the whole story (backups off, unsupported, none yet); otherwise At is
// when the last backup ran, File what it wrote, and Failed whether that run
// failed.
type BackupView struct {
	Note   string
	At     string
	File   string
	Failed bool
}

// settingsSection is one page of Settings in the secondary navigation.
type settingsSection struct {
	Key, Label string
}

// accountSections are the settings every account has; adminSections only an
// admin sees, and only an admin can open.
var (
	accountSections = []settingsSection{
		{"account", "Profile"}, {"sessions", "Sessions"}, {"tokens", "API tokens"},
	}
	adminSections = []settingsSection{
		{"network", "Network"}, {"integrations", "Integrations"}, {"notifications", "Notifications"},
		{"tags", "Tags"}, {"users", "Users"}, {"audit", "Audit log"}, {"system", "System"},
	}
)

// settingsTitle is the heading of the settings page for key.
func settingsTitle(key string) string {
	for _, sec := range append(accountSections, adminSections...) {
		if sec.Key == key {
			if key == "account" {
				return "Account"
			}
			return sec.Label
		}
	}
	return "Settings"
}

templ settingsLink(active string, sec settingsSection) {
	<li><a
		href={ templ.SafeURL("/settings/" + sec.Key) }
		if active == sec.Key {
			aria-current="page"
		}
	>{ sec.Label }</a></li>
}

// settingsNav is the secondary navigation: a list down the left on wide
// screens, wrapping rows of links on a phone. The Admin group is left out
// for a viewer.
templ settingsNav(active string) {
	<nav class="subnav" aria-label="Settings">
		<div class="subnav-group">
			<span class="subnav-h" id="subnav-account">Account</span>
			<ul class="subnav-links" aria-labelledby="subnav-account">
				for _, sec := range accountSections {
					@settingsLink(active, sec)
				}
			</ul>
		</div>
		if IsAdmin(ctx) {
			<div class="subnav-group">
				<span class="subnav-h" id="subnav-admin">Admin</span>
				<ul class="subnav-links" aria-labelledby="subnav-admin">
					for _, sec := range adminSections {
						@settingsLink(active, sec)
					}
				</ul>
			</div>
		}
	</nav>
}

templ SettingsPage(username string, d SettingsData) {
	@Layout(settingsTitle(d.ActiveTab)+" · Settings", username) {
		<div class="settings">
			@settingsNav(d.ActiveTab)
			<div class="settings-body">
				<h1>{ settingsTitle(d.ActiveTab) }</h1>
				if d.Error != "" {
					<p class="form-error" role="alert">{ Sentence(d.Error) }</p>
				}
				switch d.ActiveTab {
					case "sessions":
						@sessionsSection(d)
					case "tokens":
						@tokensTab(d)
					case "network":
						@networkSection(d)
					case "integrations":
						@integrationsTab(d)
					case "notifications":
						@notificationsTab(d.Notify)
					case "tags":
						@tagsTab(d.Tags)
					case "users":
						@usersTab(d)
					case "audit":
						@auditTab(d.Audit)
					case "system":
						@systemSection(d)
					default:
						@accountSection(username, d)
				}
			</div>
		</div>
	}
}

func generalOfflineAfter(values map[string]string) string {
	if v := values["offline_after"]; v != "" {
		return v
	}
	return "3"
}

func settingOr(values map[string]string, key, def string) string {
	if v := values[key]; v != "" {
		return v
	}
	return def
}

func defaultScanEnabled(values map[string]string) bool {
	return values["default_scan_enabled"] != "off"
}
