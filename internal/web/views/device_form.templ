package views

import (
	"fmt"
	"strings"
	
	"netis/internal/store"
)

// tagNamesJoin renders a device's tags as a comma-separated string for the
// dialog's tags input.
func tagNamesJoin(tags []store.Tag) string {
	names := make([]string, 0, len(tags))
	for _, t := range tags {
		names = append(names, t.Name)
	}
	return strings.Join(names, ", ")
}

// DeviceForm is the view-model for the create/edit device form. On a failed
// submit it carries what was typed back, with Error saying what was wrong.
type DeviceForm struct {
	Device     store.Device
	Tags       []store.Tag
	Subnets    []store.Subnet
	AllDevices []store.DeviceRow
	IsEdit     bool
	SubnetID   int64 // preselected subnet for the first interface
	IP         string
	MAC        string
	Error      string
}

func (f DeviceForm) title() string {
	if f.IsEdit {
		return "Edit device"
	}
	return "New device"
}

// action is where the form posts.
func (f DeviceForm) action() string {
	if f.IsEdit {
		return fmt.Sprintf("/devices/%d", f.Device.ID)
	}
	return "/devices"
}

// cancelURL is where the full-page form's Cancel link goes.
func (f DeviceForm) cancelURL() string {
	if f.IsEdit {
		return fmt.Sprintf("/devices/%d", f.Device.ID)
	}
	return "/devices"
}

// deviceFormInner is the shared header + form used by the centered create
// dialog, the right-side edit drawer and the full-page form served without
// htmx. In a dialog the form posts through htmx, so an error comes back into
// the dialog; on the page it is a plain post.
templ deviceFormInner(f DeviceForm, modal bool) {
	<div class="dh">
		<h3 id="dlg-title">{ f.title() }</h3>
		if modal {
			<button type="button" class="btn btn-quiet btn-icon btn-sm" data-close aria-label="Close">
					@Icon("x", "")
				</button>
		}
	</div>
	<form
		method="post"
		action={ templ.URL(f.action()) }
		if modal {
			hx-post={ f.action() }
			hx-target="#modal"
		}
	>
		<div class="db">
			if f.Error != "" {
				<p class="form-error" role="alert">{ f.Error }</p>
			}
			<label>
				Name
				<input type="text" name="name" value={ f.Device.Name } required autofocus/>
			</label>
			<label>
				Kind
				<select name="kind">
					for _, k := range deviceKinds {
						if k == f.Device.Kind {
							<option value={ k } selected>{ k }</option>
						} else {
							<option value={ k }>{ k }</option>
						}
					}
				</select>
			</label>
			<div>
				<div class="fieldlabel">Icon</div>
				<div class="iconpick" data-kind-default={ KindIcon(f.Device.Kind) }>
					for _, ic := range IconChoices {
						if ic == DeviceIcon(f.Device.Icon, f.Device.Kind) {
							<button type="button" class="ic-swatch selected" data-icon={ ic } aria-label={ "Icon " + iconLabel(ic) } title={ iconLabel(ic) } aria-pressed="true">
								@Icon(ic, "icon-lg")
							</button>
						} else {
							<button type="button" class="ic-swatch" data-icon={ ic } aria-label={ "Icon " + iconLabel(ic) } title={ iconLabel(ic) } aria-pressed="false">
								@Icon(ic, "icon-lg")
							</button>
						}
					}
				</div>
				<input type="hidden" name="icon" value={ DeviceIcon(f.Device.Icon, f.Device.Kind) }/>
			</div>
			<label>
				Vendor
				<input type="text" name="vendor" value={ f.Device.Vendor }/>
			</label>
			<label>
				Model
				<input type="text" name="model" value={ f.Device.Model }/>
			</label>
			<label>
				Function
				<input type="text" name="function" value={ f.Device.Function } placeholder="role, channel…"/>
			</label>
			<label>
				Parent device
				<select name="parent_device_id">
					<option value="">— none —</option>
					for _, pd := range f.AllDevices {
						if pd.ID != f.Device.ID {
							if f.Device.ParentDeviceID != nil && *f.Device.ParentDeviceID == pd.ID {
								<option value={ fmt.Sprint(pd.ID) } selected>{ parentLabel(pd) }</option>
							} else {
								<option value={ fmt.Sprint(pd.ID) }>{ parentLabel(pd) }</option>
							}
						}
					}
				</select>
			</label>
			<label>
				Notes
				<textarea name="notes">{ f.Device.Notes }</textarea>
			</label>
			<label>
				Tags
				<input type="text" name="tags" value={ tagNamesJoin(f.Tags) } placeholder="comma,separated"/>
			</label>
			if !f.IsEdit {
				<div class="ifgroup">
					<div class="fieldlabel">First interface (optional)</div>
					<label>
						MAC
						<input type="text" name="mac" placeholder="aa:bb:cc:dd:ee:ff" value={ f.MAC }/>
					</label>
					<label>
						IP
						<input type="text" name="ip" placeholder="10.0.0.5" value={ f.IP }/>
					</label>
					<label>
						Subnet
						<select name="subnet_id">
							<option value="">—</option>
							for _, sn := range f.Subnets {
								if sn.ID == f.SubnetID {
									<option value={ fmt.Sprint(sn.ID) } selected>{ sn.Name } { sn.CIDR }</option>
								} else {
									<option value={ fmt.Sprint(sn.ID) }>{ sn.Name } { sn.CIDR }</option>
								}
							}
						</select>
					</label>
				</div>
			}
		</div>
		<div class="df">
			if modal {
				<button type="button" class="btn" data-close>Cancel</button>
			} else {
				<a class="btn" href={ templ.URL(f.cancelURL()) }>Cancel</a>
			}
			if f.IsEdit {
				<button type="submit" class="btn btn-primary">Save</button>
			} else {
				<button type="submit" class="btn btn-primary">Create device</button>
			}
		</div>
	</form>
}

// DeviceDialog is the centered modal used for creating a device. dialog.js
// opens it with showModal() once htmx has swapped it into #modal.
templ DeviceDialog(f DeviceForm) {
	<dialog class="dialog" aria-labelledby="dlg-title">
		@deviceFormInner(f, true)
	</dialog>
}

// DeviceDrawer is the right-side sliding panel used for editing a device.
templ DeviceDrawer(f DeviceForm) {
	<dialog class="dialog drawer" aria-labelledby="dlg-title">
		@deviceFormInner(f, true)
	</dialog>
}

// DeviceFormPage is the create/edit form as a page of its own, for a request
// that did not come from htmx: the New and Edit links without JavaScript, and
// a plain post that failed validation.
templ DeviceFormPage(username string, f DeviceForm) {
	@Layout(f.title(), username) {
		<section class="dialog page-dialog" aria-labelledby="dlg-title">
			@deviceFormInner(f, false)
		</section>
	}
}

// parentLabel formats a device as "name — ip" for the parent <select>,
// omitting the dash when the device has no IP.
func parentLabel(pd store.DeviceRow) string {
	ip := lowestIPStr(pd.IPs)
	if ip == "" {
		return pd.Name
	}
	return pd.Name + " — " + ip
}
