package views

import (
	"fmt"
	"strings"

	"netis/internal/store"
)

// tagColorLabel names a palette key for people: "violet" is "Violet", and
// "" (auto) is "Auto".
func tagColorLabel(key string) string {
	if key == "" {
		return "Auto"
	}
	return strings.ToUpper(key[:1]) + key[1:]
}

// tagDevicesLabel is "1 device" or "N devices".
func tagDevicesLabel(n int) string {
	if n == 1 {
		return "1 device"
	}
	return fmt.Sprintf("%d devices", n)
}

// tagDeleteConfirm is the question asked before a tag is deleted.
func tagDeleteConfirm(t store.TagCount) string {
	if t.Devices == 0 {
		return "Delete " + t.Name + "? No device has it."
	}
	return "Remove " + t.Name + " from " + tagDevicesLabel(t.Devices) + "?"
}

// tagMergeQuestion is what the rename form says before a merge: "nas already
// exists; its 3 devices and these 2 will share it."
func tagMergeQuestion(m TagMerge) string {
	these := fmt.Sprintf("these %d", m.Devices)
	if m.Devices == 1 {
		these = "this 1"
	}
	return m.Into + " already exists; its " + tagDevicesLabel(m.IntoDevices) + " and " + these + " will share it."
}

// tagRenameAction is where a tag's rename form posts.
func tagRenameAction(id int64) templ.SafeURL {
	return templ.URL(fmt.Sprintf("/settings/tags/%d/rename", id))
}

// tagChipID is the id of the chip cell a colour change redraws.
func tagChipID(id int64) string { return fmt.Sprintf("tag-chip-%d", id) }

// tagsTab is the admin's Tags page: each tag with its device count, a colour
// picker, rename and delete. A rename that would merge two tags is asked
// about in that tag's row (merge) before it happens.
templ tagsTab(tags []store.TagCount, merge TagMerge) {
	<div class="panel">
		if len(tags) == 0 {
			<p class="empty-note">No tags yet. Add tags to devices from their edit form or the device list.</p>
		} else {
			<div class="table-wrap">
				<table class="table-stack">
					<thead>
						<tr><th>Tag</th><th>Devices</th><th>Colour</th><th><span class="sr-only">Actions</span></th></tr>
					</thead>
					<tbody>
						for _, t := range tags {
							<tr>
								<td data-label="Tag"><span id={ tagChipID(t.ID) }>@TagSpan(t.Name, t.Color)</span></td>
								<td data-label="Devices"><a class="tag-count" href={ tagHref(t.Name) }>{ tagDevicesLabel(t.Devices) }</a></td>
								<td data-label="Colour">@tagColorPicker(t)</td>
								<td class="cell-actions">
									if merge.ID == t.ID {
										<form method="post" action={ tagRenameAction(t.ID) } class="inline tag-merge" role="alert">
											<span class="tag-merge-question">{ tagMergeQuestion(merge) }</span>
											<input type="hidden" name="name" value={ merge.Into }/>
											<input type="hidden" name="confirm" value="1"/>
											<button type="submit" class="btn btn-sm">Merge</button>
											<a class="btn btn-sm" href="/settings/tags">Cancel</a>
										</form>
									} else {
										<form method="post" action={ tagRenameAction(t.ID) } class="inline tag-rename">
											<input type="text" name="name" value={ t.Name } aria-label={ "New name for " + t.Name } required autocomplete="off"/>
											<button type="submit" class="btn btn-sm">Rename</button>
										</form>
									}
									<form method="post" action={ templ.URL(fmt.Sprintf("/settings/tags/%d/delete", t.ID)) } class="inline" data-confirm={ tagDeleteConfirm(t) }>
										<button type="submit" class="btn btn-danger btn-sm">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="hint">Renaming a tag to a name another tag has merges the two, once you confirm; the merged tag keeps that tag's colour.</p>
		}
	</div>
}

// tagColorPicker is a tag's colour as a radio group of swatches: Auto (drawn
// in the hue the name resolves to) and then the palette. With JavaScript a
// change saves at once; without it, the Save button posts the form.
templ tagColorPicker(t store.TagCount) {
	<form
		method="post"
		action={ templ.URL(fmt.Sprintf("/settings/tags/%d/color", t.ID)) }
		hx-post={ fmt.Sprintf("/settings/tags/%d/color", t.ID) }
		hx-trigger="change delay:600ms"
		hx-swap="none"
		class="tag-picker"
	>
		<fieldset class="tag-swatches">
			<legend class="sr-only">{ "Colour for " + t.Name }</legend>
			@tagSwatch("", TagColor(t.Name, ""), !IsTagColor(t.Color))
			for _, key := range TagPalette {
				@tagSwatch(key, key, t.Color == key)
			}
		</fieldset>
		<noscript><button type="submit" class="btn btn-sm">Save</button></noscript>
	</form>
}

// tagSwatch is one choice in the picker: value is what it posts, hue the
// palette key it is drawn in.
templ tagSwatch(value, hue string, checked bool) {
	<label class={ "tag-swatch", "tag-" + hue } title={ tagColorLabel(value) }>
		<input type="radio" name="color" value={ value } class="sr-only" aria-label={ tagColorLabel(value) } checked?={ checked }/>
		<span class="tag-swatch-dot" aria-hidden="true"></span>
		if value == "" {
			<span class="tag-swatch-text" aria-hidden="true">Auto</span>
		}
	</label>
}

// TagColorSaved answers a colour change made through htmx: the tag's chip in
// its new colour and a toast, both swapped in out of band.
templ TagColorSaved(t store.Tag) {
	<span id={ tagChipID(t.ID) } hx-swap-oob="true">@TagSpan(t.Name, t.Color)</span>
	<div id="toasts" hx-swap-oob="beforeend"><div class="toast">Colour saved</div></div>
}
