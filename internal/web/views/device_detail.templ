package views

import (
	"fmt"
	
	"netis/internal/macaddr"
	"netis/internal/store"
)

// IfaceDetail bundles an interface with everything the device detail page
// shows about it: its IPs, open ports, and rolling availability.
type IfaceDetail struct {
	Iface           store.Iface
	IPs             []store.IPRow
	Ports           []store.OpenPort
	AvailabilityPct float64
	Online          bool
	LastSeen        string
}

// DeviceDetail is the full view-model for the device detail page.
type DeviceDetail struct {
	Device   store.Device
	Ifaces   []IfaceDetail
	Tags     []store.Tag
	Fields   []store.CustomField
	Links    []store.Link
	Children []store.Device
	Parent   *store.Device
	Events   []store.Event
	// AlertOffline is whether the device's offline and online events are
	// sent as notifications.
	AlertOffline bool
}

// HasMAC says whether any of the device's interfaces has a MAC address,
// which Wake on LAN needs.
func (d DeviceDetail) HasMAC() bool {
	for _, f := range d.Ifaces {
		if f.Iface.MAC != nil && *f.Iface.MAC != "" {
			return true
		}
	}
	return false
}

// anyOnline reports whether any interface of the device is currently online.
func anyOnline(ifds []IfaceDetail) bool {
	for _, f := range ifds {
		if f.Online {
			return true
		}
	}
	return false
}

templ DevicePage(username string, d DeviceDetail) {
	@Layout(d.Device.Name, username) {
		<div class="dev-hero panel">
			<div class="dev-hero-main">
				@deviceIcon(d.Device.Icon, d.Device.Kind, "ic-lg")
				<div class="dev-hero-head">
					<h1>
						{ d.Device.Name }
						<span class="chip">{ d.Device.Kind }</span>
						if d.Device.Kind == "vm" || d.Device.Kind == "lxc" {
							for _, f := range d.Fields {
								if f.Key == "proxmox_status" {
									<span class="chip">{ f.Value }</span>
								}
							}
						}
						if anyOnline(d.Ifaces) {
							<span class="status is-online">online</span>
						} else {
							<span class="status is-offline">offline</span>
						}
						@missingUpstreamPill(d.Device)
						if d.AlertOffline {
							<span class="chip" title="Offline and online changes are sent as notifications">
								@Icon("bell", "")
								offline alerts on
							</span>
						}
					</h1>
					if joinNonEmpty(" · ", d.Device.Vendor, d.Device.Model, d.Device.Function) != "" {
						<p class="muted">{ joinNonEmpty(" · ", d.Device.Vendor, d.Device.Model, d.Device.Function) }</p>
					}
					if d.Device.Notes != "" {
						<p class="dev-notes">{ d.Device.Notes }</p>
					}
				</div>
			</div>
			if IsAdmin(ctx) {
				<div class="dev-hero-actions">
					<a class="btn btn-primary" href={ templ.URL(fmt.Sprintf("/devices/%d/edit", d.Device.ID)) } hx-get={ fmt.Sprintf("/devices/%d/edit", d.Device.ID) } hx-target="#modal">
							@Icon("pencil", "")
							Edit
						</a>
					if d.HasMAC() {
						<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/wol", d.Device.ID)) } class="inline" hx-post={ fmt.Sprintf("/devices/%d/wol", d.Device.ID) } hx-target="#toasts" hx-swap="beforeend">
							<button type="submit" class="btn">
									@Icon("power", "")
									Wake on LAN
								</button>
						</form>
					}
					<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/portscan", d.Device.ID)) } class="inline">
						<button type="submit" class="btn">
								@Icon("radar", "")
								Scan ports
							</button>
					</form>
					<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/alert", d.Device.ID)) } class="inline">
						if d.AlertOffline {
							<input type="hidden" name="alert_offline" value="0"/>
							<button type="submit" class="btn">Stop offline alerts</button>
						} else {
							<input type="hidden" name="alert_offline" value="1"/>
							<button type="submit" class="btn" title="Send a notification when this device goes offline or comes back">
									@Icon("bell", "")
									Alert when offline
								</button>
						}
					</form>
				</div>
			}
		</div>
		<div class="dev-cols">
			<div class="dev-main">
				<div class="panel">
					<h2>Interfaces</h2>
					for _, ifd := range d.Ifaces {
						<div class="iface">
							<p class="mono">
								if ifd.Iface.MAC != nil {
									{ *ifd.Iface.MAC }
									if macaddr.IsPrivate(*ifd.Iface.MAC) {
										{ " " }
										<span class="chip" title={ privateMACTitle }>private MAC</span>
									}
								}
								if ifd.Iface.Hostname != nil {
									{ " " } { *ifd.Iface.Hostname }
								}
								if ifd.Online {
									<span class="status is-online">online</span>
								} else {
									<span class="status is-offline">offline</span>
								}
							</p>
							<p class="muted">
								Last seen{ " " }
								@Time(ifd.LastSeen)
								{ " · " }Availability (30d): { fmt.Sprintf("%.1f%%", ifd.AvailabilityPct) }
							</p>
							<table>
								<tr>
									<th>IP</th>
									<th>Lease</th>
								</tr>
								for _, ip := range ifd.IPs {
									<tr>
										<td class="mono">{ ip.IP }</td>
										<td>
											if ip.SubnetID != 0 && IsAdmin(ctx) {
												@LeaseToggle(d.Device.ID, ip.SubnetID, ip.IP, ip.Kind)
											} else {
												<span class={ "chip", ip.Kind }>{ ip.Kind }</span>
											}
										</td>
									</tr>
								}
							</table>
							if len(ifd.Ports) > 0 {
								<table>
									<tr>
										<th>Port</th>
										<th>Proto</th>
										<th>Service</th>
										<th>Last seen</th>
									</tr>
									for _, p := range ifd.Ports {
										<tr>
											<td>{ fmt.Sprint(p.Port) }</td>
											<td>{ p.Proto }</td>
											<td>{ p.ServiceGuess }</td>
											<td>@Time(p.LastSeen)</td>
										</tr>
									}
								</table>
							}
						</div>
					}
				</div>
			</div>
			<div class="dev-aside">
				<div class="panel">
					<h2>Tags</h2>
					<p>
						for _, t := range d.Tags {
							<span class="chip">{ t.Name }</span>{ " " }
						}
					</p>
				</div>
				<div class="panel">
					<h2>Links</h2>
					<ul class="linklist">
						for _, l := range d.Links {
							<li>
								<a href={ templ.URL(l.URL) } target="_blank" rel="noopener">{ l.Label }</a>
								if IsAdmin(ctx) {
									<form method="post" action={ templ.URL(fmt.Sprintf("/links/%d/delete", l.ID)) } class="inline" data-confirm={ "Remove the link " + l.Label + "?" }>
										<input type="hidden" name="device_id" value={ fmt.Sprint(d.Device.ID) }/>
										<button type="submit" class="btn btn-quiet btn-sm">remove</button>
									</form>
								}
							</li>
						}
					</ul>
					if IsAdmin(ctx) {
						<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/links", d.Device.ID)) } class="rowform">
							<input type="text" name="label" placeholder="label" required/>
							<input type="text" name="url" placeholder="https://…" required/>
							<button type="submit" class="btn">Add link</button>
						</form>
					}
				</div>
				<div class="panel">
					<h2>Custom fields</h2>
					<table>
						<tr>
							<th>Key</th>
							<th>Value</th>
							<th></th>
						</tr>
						for _, f := range d.Fields {
							<tr>
								<td class="mono">{ f.Key }</td>
								<td>{ f.Value }</td>
								<td>
									if IsAdmin(ctx) {
										<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/fields/delete", d.Device.ID)) } class="inline" data-confirm={ "Remove the field " + f.Key + "?" }>
											<input type="hidden" name="key" value={ f.Key }/>
											<button type="submit" class="btn btn-quiet btn-sm">remove</button>
										</form>
									}
								</td>
							</tr>
						}
					</table>
					if IsAdmin(ctx) {
						<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/fields", d.Device.ID)) } class="rowform">
							<input type="text" name="key" placeholder="key" required/>
							<input type="text" name="value" placeholder="value"/>
							<button type="submit" class="btn">Set field</button>
						</form>
					}
				</div>
				<div class="panel">
					<h2>Parent / children</h2>
					if d.Parent != nil {
						<p>Parent: <a href={ templ.URL(fmt.Sprintf("/devices/%d", d.Parent.ID)) }>{ d.Parent.Name }</a></p>
					}
					if len(d.Children) > 0 {
						<ul>
							for _, c := range d.Children {
								<li><a href={ templ.URL(fmt.Sprintf("/devices/%d", c.ID)) }>{ c.Name }</a></li>
							}
						</ul>
					}
					if d.Parent == nil && len(d.Children) == 0 {
						<p class="muted">No parent or children.</p>
					}
				</div>
				<div class="panel">
					<h2>Event history</h2>
					<table>
						for _, e := range d.Events {
							<tr>
								<td>@Time(e.TS)</td>
								<td>@EventStatus(e)</td>
								<td>{ EventDetail(e) }</td>
							</tr>
						}
					</table>
				</div>
				if IsAdmin(ctx) {
					<div class="panel">
						<h2>Danger zone</h2>
						<form method="post" action={ templ.URL(fmt.Sprintf("/devices/%d/delete", d.Device.ID)) } data-confirm={ "Delete " + d.Device.Name + " and everything recorded about it?" }>
							<button type="submit" class="btn btn-danger">
									@Icon("trash-2", "")
									Delete device
								</button>
						</form>
					</div>
				}
			</div>
		</div>
	}
}
