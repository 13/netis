package views

import (
	"fmt"

	"netis/internal/autofill"
	"netis/internal/macaddr"
	"netis/internal/store"
)

// IfaceDetail bundles an interface with everything the device detail page
// shows about it: its IPs, open ports, and rolling availability.
type IfaceDetail struct {
	Iface           store.Iface
	IPs             []store.IPRow
	Ports           []store.OpenPort
	AvailabilityPct float64
	Online          bool
	LastSeen        string
}

// DeviceDetail is the full view-model for the device detail page.
type DeviceDetail struct {
	Device   store.Device
	Ifaces   []IfaceDetail
	Tags     []store.Tag
	Fields   []store.CustomField
	Links    []store.Link
	Children []store.DeviceRow
	Parent   *store.DeviceRow
	Events   []store.Event
	// Subnets are the subnets the device's IPs belong to, by id, so each
	// address can link to its grid.
	Subnets map[int64]store.Subnet
	// Availability is the device's last 30 days, one entry per day.
	Availability Availability
	// AlertOffline is whether the device's offline and online events are
	// sent as notifications.
	AlertOffline bool
	Back         BackLink
	// Detected is every autofill hint for the device with what became of it.
	Detected []autofill.Explained
	// Autofilled holds the values autofill wrote that the device still
	// shows, by field (vendor, kind, …; tags as tag:<name>).
	Autofilled map[string]store.AutofillRecord
}

// HasMAC says whether any of the device's interfaces has a MAC address,
// which Wake on LAN needs.
func (d DeviceDetail) HasMAC() bool {
	for _, f := range d.Ifaces {
		if f.Iface.MAC != nil && *f.Iface.MAC != "" {
			return true
		}
	}
	return false
}

// anyOnline reports whether any interface of the device is currently online.
func anyOnline(ifds []IfaceDetail) bool {
	for _, f := range ifds {
		if f.Online {
			return true
		}
	}
	return false
}

// onlineStatus is the status label for a device or interface.
templ onlineStatus(online bool) {
	if online {
		<span class="status is-online">Online</span>
	} else {
		<span class="status is-offline">Offline</span>
	}
}

templ DevicePage(username string, d DeviceDetail) {
	@Layout(d.Device.Name, username) {
		<a class="dd-back" href={ templ.SafeURL(d.Back.URL) }>
			@Icon("arrow-left", "")
			{ d.Back.Label }
		</a>
		@deviceHeader(d)
		@availabilityPanel(d.Availability)
		<section class="dd-section" aria-labelledby="dd-overview">
			<h2 id="dd-overview">Overview</h2>
			<div class="dd-grid">
				@aboutPanel(d)
				@detectedPanel(d)
				@relatedPanel(d)
				@linksPanel(d)
				@fieldsPanel(d)
			</div>
		</section>
		<section class="dd-section" aria-labelledby="dd-network">
			<h2 id="dd-network">Network</h2>
			if len(d.Ifaces) == 0 {
				<div class="panel">
					<div class="empty">
						@Icon("network", "")
						<h3>No network interfaces</h3>
						<p>netis has not seen this device on a subnet, and it has no MAC or IP recorded.</p>
					</div>
				</div>
			}
			for _, ifd := range d.Ifaces {
				@ifacePanel(d, ifd)
			}
		</section>
		<section class="dd-section" aria-labelledby="dd-activity">
			<h2 id="dd-activity">Activity</h2>
			@deviceActivityPanel(d)
		</section>
	}
}

// deviceHeader is the page head: icon, name, what the device is and its
// state, and on the right what an admin can do with it.
templ deviceHeader(d DeviceDetail) {
	<header class="dd-head">
		@deviceIcon(d.Device.Icon, d.Device.Kind, "ic-lg")
		<div class="dd-title">
			<h1>{ d.Device.Name }</h1>
			<div class="dd-meta">
				@onlineStatus(anyOnline(d.Ifaces))
				if !d.Device.Reviewed {
					<span class="status is-new" title="Found by a scan and not reviewed yet">New</span>
				}
				@missingUpstreamPill(d.Device)
				if ip := d.primaryIP(); ip != "" {
					<span class="mono">{ ip }</span>
				}
				<span>{ kindName(d.Device.Kind) }</span>
				if vm := joinNonEmpty(" ", d.Device.Vendor, d.Device.Model); vm != "" {
					<span class="muted">{ vm }</span>
				}
				if ps := d.proxmoxStatus(); ps != "" {
					<span class="chip" title="State in Proxmox">{ Sentence(ps) }</span>
				}
				if d.hasPrivateMAC() {
					<span class="chip" title={ privateMACTitle }>Private MAC</span>
				}
				if d.AlertOffline {
					<span class="chip" title="Offline and online changes are sent as notifications">
						@Icon("bell", "")
						Offline alerts on
					</span>
				}
			</div>
		</div>
		if IsAdmin(ctx) {
			<div class="dd-actions">
				if !d.Device.Reviewed {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/approve", d.Device.ID)) } class="inline">
						<input type="hidden" name="next" value={ fmt.Sprintf("/devices/%d", d.Device.ID) }/>
						<button type="submit" class="btn btn-primary">
							@Icon("check", "")
							Approve
						</button>
					</form>
				}
				<a
					if d.Device.Reviewed {
						class="btn btn-primary"
					} else {
						class="btn"
					}
					href={ templ.SafeURL(fmt.Sprintf("/devices/%d/edit", d.Device.ID)) }
					hx-get={ fmt.Sprintf("/devices/%d/edit", d.Device.ID) }
					hx-target="#modal"
				>
					@Icon("pencil", "")
					Edit
				</a>
				@moreMenu(d)
			</div>
		}
	</header>
}

// moreMenu holds the device's less frequent actions, Delete last and set
// apart.
templ moreMenu(d DeviceDetail) {
	<details class="more dd-more">
		<summary class="btn" aria-label="More actions">
			@Icon("ellipsis", "")
			<span class="lbl">More</span>
		</summary>
		<div class="menu" role="group" aria-label="More actions">
			if d.HasMAC() {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/wol", d.Device.ID)) } class="menu-form" hx-post={ fmt.Sprintf("/devices/%d/wol", d.Device.ID) } hx-target="#toasts" hx-swap="beforeend">
					<button type="submit" class="menu-item">
						@Icon("power", "")
						Wake on LAN
					</button>
				</form>
			}
			if d.primaryIP() != "" {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/portscan", d.Device.ID)) } class="menu-form">
					<button type="submit" class="menu-item">
						@Icon("radar", "")
						Scan ports
					</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/alert", d.Device.ID)) } class="menu-form">
				if d.AlertOffline {
					<input type="hidden" name="alert_offline" value="0"/>
					<button type="submit" class="menu-item" aria-pressed="true">
						@Icon("bell", "")
						Turn off offline alerts
					</button>
				} else {
					<input type="hidden" name="alert_offline" value="1"/>
					<button type="submit" class="menu-item" aria-pressed="false" title="Send a notification when this device goes offline or comes back">
						@Icon("bell", "")
						Turn on offline alerts
					</button>
				}
			</form>
			<hr/>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/delete", d.Device.ID)) } class="menu-form" data-confirm={ "Delete " + d.Device.Name + " and everything recorded about it? This cannot be undone." }>
				<button type="submit" class="menu-item danger">
					@Icon("trash-2", "")
					Delete device
				</button>
			</form>
		</div>
	</details>
}

// availabilityPanel draws the last 30 days as one bar per day, the online
// share filled from the bottom, with the figure in words beside it.
templ availabilityPanel(a Availability) {
	<section class="panel dd-avail" aria-labelledby="dd-avail-h">
		<div class="panel-head">
			<h2 id="dd-avail-h">Availability</h2>
			if a.HasData {
				<span class="dd-avail-pct">{ fmtPct(a.Pct) }</span>
			}
			<span class="muted">last 30 days</span>
		</div>
		<svg class="avail-bar" viewBox="0 0 300 40" preserveAspectRatio="none" role="img" aria-label={ availSummary(a) }>
			for _, b := range availBars(a) {
				<g class={ "day", b.Tone }>
					<title>{ availBarTitle(b.Day) }</title>
					<rect class="track" x={ b.X } y="0" width="8" height="40" rx="1"></rect>
					if b.Day.HasData {
						<rect class="fill" x={ b.X } y={ b.FillY } width="8" height={ b.FillH } rx="1"></rect>
					}
				</g>
			}
		</svg>
		<div class="avail-axis muted" aria-hidden="true">
			<span>30 days ago</span>
			<span>Today</span>
		</div>
		<p class="hint">{ availSummary(a) }</p>
	</section>
}

// sourceName says where the device came from.
func sourceName(src string) string {
	switch src {
	case "manual":
		return "Added by hand"
	case "scan":
		return "Found by a scan"
	case "proxmox":
		return "Proxmox"
	case "wireguard":
		return "WireGuard"
	case "pihole":
		return "Pi-hole"
	case "adguard":
		return "AdGuard Home"
	case "opnsense":
		return "OPNsense"
	case "":
		return "Unknown"
	}
	return src
}

templ aboutPanel(d DeviceDetail) {
	<div class="panel">
		<h3>About</h3>
		if d.Device.Notes != "" {
			<p class="dd-notes">{ d.Device.Notes }</p>
		}
		<dl class="facts dd-facts">
			<dt>Kind</dt>
			<dd>
				{ kindName(d.Device.Kind) }
				@detectedBadge(d.detectedFrom("kind"))
			</dd>
			if d.Device.Vendor != "" {
				<dt>Vendor</dt>
				<dd>
					{ d.Device.Vendor }
					@detectedBadge(d.detectedFrom("vendor"))
				</dd>
			}
			if d.Device.Model != "" {
				<dt>Model</dt>
				<dd>
					{ d.Device.Model }
					@detectedBadge(d.detectedFrom("model"))
				</dd>
			}
			if d.Device.Function != "" {
				<dt>Function</dt>
				<dd>
					{ d.Device.Function }
					@detectedBadge(d.detectedFrom("function"))
				</dd>
			}
			<dt>Source</dt>
			<dd>{ sourceName(d.Device.Source) }</dd>
			<dt>Tags</dt>
			<dd>
				if len(d.Tags) > 0 {
					<span class="dd-tags">
						for _, t := range d.Tags {
							<span class="chip">{ t.Name }</span>
						}
					</span>
				} else {
					<span class="muted">None</span>
				}
			</dd>
		</dl>
		if d.Device.Notes == "" && d.Device.Function == "" && len(d.Tags) == 0 && IsAdmin(ctx) {
			<p class="hint">Add notes, tags or a function with Edit.</p>
		}
	</div>
}

// detectedBadge marks a value autofill filled in, naming where it came from.
templ detectedBadge(title string) {
	if title != "" {
		<span class="chip chip-detected" title={ title }>Detected</span>
	}
}

// detectedPanel lists every clue autofill has about the device and what
// became of each. It stays closed: the Detected badges in About say what
// was used, and this is the why.
templ detectedPanel(d DeviceDetail) {
	if len(d.Detected) > 0 {
		<details class="panel dd-detected">
			<summary>
				@Icon("chevron-right", "disc-chev")
				<h3>What netis detected</h3>
				<span class="count">{ fmt.Sprint(len(d.Detected)) }</span>
			</summary>
			<div class="table-wrap">
				<table class="table-stack">
					<thead>
						<tr><th scope="col">Field</th><th scope="col">Value</th><th scope="col">From</th><th scope="col">Status</th></tr>
					</thead>
					<tbody>
						for _, e := range d.Detected {
							<tr>
								<td data-label="Field">{ fieldText[e.Field] }</td>
								<td data-label="Value">{ hintValue(e) }</td>
								<td data-label="From">
									<span>
										{ Sentence(sourceLabel(e.Source)) }
										if e.Detail != "" {
											<span class="muted mono">{ e.Detail }</span>
										}
									</span>
								</td>
								<td data-label="Status">
									if e.Status == autofill.StatusApplied {
										{ d.hintStatus(e) }
									} else {
										<span class="muted">{ d.hintStatus(e) }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
}

// relatedRow is a parent or child: icon, linked name, IP and status.
templ relatedRow(r store.DeviceRow) {
	<li>
		@deviceIcon(r.Icon, r.Kind, "")
		<a href={ templ.SafeURL(fmt.Sprintf("/devices/%d", r.ID)) }>{ r.Name }</a>
		if ip := relatedIP(r); ip != "" {
			<span class="mono muted">{ ip }</span>
		}
		<span class="spacer"></span>
		@onlineStatus(r.Online)
	</li>
}

templ relatedPanel(d DeviceDetail) {
	<div class="panel">
		<h3>Connected to</h3>
		if d.Parent == nil && len(d.Children) == 0 {
			<p class="muted">No parent or child devices. Set a parent with Edit, for example the switch this device is plugged into.</p>
		} else {
			if d.Parent != nil {
				<p class="dd-sub">Parent</p>
				<ul class="dd-related">
					@relatedRow(*d.Parent)
				</ul>
			}
			if len(d.Children) > 0 {
				<p class="dd-sub">Children <span class="count">{ fmt.Sprint(len(d.Children)) }</span></p>
				<ul class="dd-related">
					for _, c := range d.Children {
						@relatedRow(c)
					}
				</ul>
			}
		}
	</div>
}

templ linksPanel(d DeviceDetail) {
	<div class="panel">
		<h3>Links</h3>
		if len(d.Links) == 0 {
			<p class="muted">No links yet. Add the device's web interface or documentation.</p>
		} else {
			<ul class="dd-list">
				for _, l := range d.Links {
					<li>
						<a href={ templ.URL(l.URL) } target="_blank" rel="noopener">
							{ l.Label }
							@Icon("external-link", "")
						</a>
						<span class="muted dd-url">{ l.URL }</span>
						if IsAdmin(ctx) {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/delete", l.ID)) } class="inline" data-confirm={ "Delete the link " + l.Label + "?" }>
								<input type="hidden" name="device_id" value={ fmt.Sprint(d.Device.ID) }/>
								<button type="submit" class="btn btn-quiet btn-icon btn-sm" aria-label={ "Delete link " + l.Label } title="Delete link">
									@Icon("x", "")
								</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if IsAdmin(ctx) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/links", d.Device.ID)) } class="dd-add">
				<label>
					<span class="sr-only">Link label</span>
					<input type="text" name="label" placeholder="Label" required autocomplete="off"/>
				</label>
				<label class="grow">
					<span class="sr-only">Link URL</span>
					<input type="url" name="url" placeholder="https://…" required autocomplete="off"/>
				</label>
				<button type="submit" class="btn btn-sm">
					@Icon("plus", "")
					Add link
				</button>
			</form>
		}
	</div>
}

templ fieldsPanel(d DeviceDetail) {
	<div class="panel">
		<h3>Custom fields</h3>
		if len(d.Fields) == 0 {
			<p class="muted">No custom fields. Record anything else worth knowing, like a rack slot or a serial number.</p>
		} else {
			<dl class="dd-fields">
				for _, f := range d.Fields {
					<div>
						<dt>{ f.Key }</dt>
						<dd>
							<span>{ f.Value }</span>
							if IsAdmin(ctx) {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/fields/delete", d.Device.ID)) } class="inline" data-confirm={ "Delete the field " + f.Key + "?" }>
									<input type="hidden" name="key" value={ f.Key }/>
									<button type="submit" class="btn btn-quiet btn-icon btn-sm" aria-label={ "Delete field " + f.Key } title="Delete field">
										@Icon("x", "")
									</button>
								</form>
							}
						</dd>
					</div>
				}
			</dl>
		}
		if IsAdmin(ctx) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/devices/%d/fields", d.Device.ID)) } class="dd-add">
				<label>
					<span class="sr-only">Field name</span>
					<input type="text" name="key" placeholder="Name" required autocomplete="off"/>
				</label>
				<label class="grow">
					<span class="sr-only">Field value</span>
					<input type="text" name="value" placeholder="Value" autocomplete="off"/>
				</label>
				<button type="submit" class="btn btn-sm">
					@Icon("plus", "")
					Save field
				</button>
			</form>
		}
	</div>
}

// ifacePanel is one interface: its identity and state on top, then its
// addresses and open ports side by side.
templ ifacePanel(d DeviceDetail, ifd IfaceDetail) {
	<div class="panel dd-iface">
		<div class="panel-head">
			<h3>
				if ifd.Iface.MAC != nil && *ifd.Iface.MAC != "" {
					<span class="mono">{ *ifd.Iface.MAC }</span>
				} else {
					Interface without MAC
				}
			</h3>
			if ifd.Iface.MAC != nil && macaddr.IsPrivate(*ifd.Iface.MAC) {
				<span class="chip" title={ privateMACTitle }>Private MAC</span>
			}
			if ifd.Iface.Hostname != nil && *ifd.Iface.Hostname != "" {
				<span class="muted">{ *ifd.Iface.Hostname }</span>
			}
			@onlineStatus(ifd.Online)
			<span class="spacer"></span>
			<span class="muted text-sm">
				if ifd.LastSeen != "" {
					Last seen{ " " }
					@Time(ifd.LastSeen)
					{ " · " }
				} else {
					Never seen{ " · " }
				}
				{ fmtPct(ifd.AvailabilityPct) } over 30 days
			</span>
		</div>
		<div class="dd-iface-body">
			<div>
				<h4>Addresses</h4>
				if len(ifd.IPs) == 0 {
					<p class="muted">No IP addresses.</p>
				} else {
					<div class="table-wrap">
						<table class="table-stack table-stack-inline">
							<thead>
								<tr><th>IP</th><th>Subnet</th><th>Lease</th></tr>
							</thead>
							<tbody>
								for _, ip := range ifd.IPs {
									<tr>
										<td class="mono">{ ip.IP }</td>
										<td>
											if sn, ok := d.subnetOf(ip.SubnetID); ok {
												<a href={ templ.SafeURL(fmt.Sprintf("/subnets/%d", sn.ID)) }>{ sn.Name }</a>
												<span class="mono muted text-sm">{ sn.CIDR }</span>
											} else {
												<span class="muted">—</span>
											}
										</td>
										<td>
											if ip.SubnetID != 0 && IsAdmin(ctx) {
												@LeaseToggle(d.Device.ID, ip.SubnetID, ip.IP, ip.Kind)
											} else {
												<span class={ "chip", ip.Kind }>{ leaseLabel(ip.Kind) }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			<div>
				<h4>Open ports</h4>
				if len(ifd.Ports) == 0 {
					<p class="muted">
						No open ports recorded.
						if IsAdmin(ctx) && len(ifd.IPs) > 0 {
							{ " " }Run Scan ports from the More menu to check.
						}
					</p>
				} else {
					<div class="table-wrap">
						<table class="table-stack table-stack-inline">
							<thead>
								<tr><th>Port</th><th>Service</th><th>Last seen</th></tr>
							</thead>
							<tbody>
								for _, p := range ifd.Ports {
									<tr>
										<td class="mono">{ fmt.Sprint(p.Port) }/{ p.Proto }</td>
										<td>
											if p.ServiceGuess != "" {
												{ p.ServiceGuess }
											} else {
												<span class="muted">Unknown</span>
											}
										</td>
										<td class="muted">
											@Time(p.LastSeen)
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	</div>
}

templ deviceActivityPanel(d DeviceDetail) {
	<div class="panel">
		if len(d.Events) == 0 {
			<div class="empty">
				@Icon("activity", "")
				<h3>No events yet</h3>
				<p>Changes such as going offline, a new IP or a conflict show up here.</p>
			</div>
		} else {
			<div class="table-wrap">
				<table class="dd-events">
					<thead>
						<tr><th>When</th><th>Event</th><th>Details</th></tr>
					</thead>
					<tbody>
						for _, e := range d.Events {
							<tr>
								<td class="muted">
									@Time(e.TS)
								</td>
								<td>
									@EventStatus(e)
								</td>
								<td>{ EventDetail(e) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(d.Events) >= DeviceEventLimit {
				<p class="hint">
					Showing the latest { fmt.Sprint(len(d.Events)) } events.{ " " }
					<a href="/events">See all events</a>
				</p>
			}
		}
	</div>
}
